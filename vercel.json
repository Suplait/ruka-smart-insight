{
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/home-anterior",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/v2/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/register", "destination": "/register/index.html" },
    { "source": "/register/", "destination": "/register/index.html" },
    { "source": "/restaurantes", "destination": "/restaurantes/index.html" },
    { "source": "/restaurantes/", "destination": "/restaurantes/index.html" },
    { "source": "/hoteles", "destination": "/hoteles/index.html" },
    { "source": "/hoteles/", "destination": "/hoteles/index.html" },
    { "source": "/retail", "destination": "/retail/index.html" },
    { "source": "/retail/", "destination": "/retail/index.html" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
